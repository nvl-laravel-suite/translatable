{
    "name": "nvl/translatable",
    "description": "Typed related-row and grouped self-row translations for Laravel Eloquent models",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "localization", "translation", "i18n"],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nvl/data": "^2.0",
        "nvl/support": "^2.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Translatable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Translatable\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Translatable\\Providers\\TranslatableServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
